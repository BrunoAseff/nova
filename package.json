{
  "name": "nova",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest",
    "check": "biome ci . && tsc -b && vitest run && vite build",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@biomejs/biome": "^2.6.9",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "wrangler": "^4.168.0"
  }
}
